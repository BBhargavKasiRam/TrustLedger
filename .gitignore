# ==============================================================================
# VidyaKosh — Git Ignore Configuration
# ==============================================================================

# Environment Variables & Secrets (CRITICAL SECURITY)
.env
*.env
*.env.*
!.env.example
atlas-credentials*.env
credentials.json
service-account*.json

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# SQLite / Database Local Files
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
aicte_fdr.db
backend/aicte_fdr.db

# Node.js & Frontend Artifacts
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
.vite/
frontend/.vite/
*.local

# IDE & Editor Specific Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Testing & Coverage
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
htmlcov/

# Logs & Runtime Dumps
*.log
logs/
*.pid

# Dynamic uploads / test runs (keep sample presets intact)
backend/static/uploads/*
!backend/static/uploads/.gitkeep
backend/static/ela_outputs/ela_*
backend/static/ela_outputs/test_*
!backend/static/ela_outputs/.gitkeep

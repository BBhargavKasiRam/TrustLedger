# Google Gemini GenAI API Key (for Multimodal AI OCR & Document Extraction)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# MongoDB Database Connection String (MongoDB Atlas Cloud Cluster)
MONGODB_URL="mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/"

# Server Settings
HOST="127.0.0.1"
PORT=8000
